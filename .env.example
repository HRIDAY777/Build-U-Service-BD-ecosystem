# Copy to .env for Docker. For local shells, export values explicitly.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,api.uservicebd.com,www.uservicebd.com,admin.uservicebd.com
POSTGRES_DB=uservice
POSTGRES_USER=uservice
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://uservice:REPLACE_PASSWORD@db:5432/uservice
REDIS_URL=redis://redis:6379/0
REDIS_CACHE=true
CSRF_TRUSTED_ORIGINS=https://www.uservicebd.com,https://account.uservicebd.com,https://admin.uservicebd.com
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_SITE_URL=https://www.uservicebd.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@uservicebd.com
# OpenAI-compatible chat-completions endpoint; server-side only.
AI_CHAT_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_DAILY_USER_LIMIT=20
# Reserved integration configuration: see docs/INTEGRATIONS.md for implementation status.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
PAYMENT_PUBLIC_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
SMS_API_URL=
SMS_API_KEY=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAPS_API_KEY=
SENTRY_DSN=
